# ── LLM: Google Gemini ────────────────────────────────────────────────
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
# Tried in order if the primary model fails (quota / overload / retired model id)
GEMINI_FALLBACK_MODELS=gemini-3-flash
# low | medium | high | (empty = model default). Low keeps latency down for RAG.
GEMINI_THINKING_LEVEL=low
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
# gemini | groq | extractive (extractive = no LLM, returns passages)
LLM_BACKEND=gemini

# ── Retrieval models ──────────────────────────────────────────────────
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Light default (~90 MB). Heavier / multilingual: BAAI/bge-reranker-base. "none" disables reranking.
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
# Below this best reranker score the assistant says "I don't know" instead of guessing.
ABSTAIN_RERANK_THRESHOLD=-4.0

# ── Conversation / demo guard rails ───────────────────────────────────
MEMORY_TURNS=4
MAX_QUESTIONS_PER_SESSION=40
MAX_QUESTION_CHARS=600

# ── Ops ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Optional: Groq backend (uncomment groq in requirements.txt) ─
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# ── Optional: Elasticsearch BM25 (default: local rank_bm25) ───────────
USE_ELASTICSEARCH=false
# ELASTICSEARCH_URL=http://localhost:9200
# ELASTICSEARCH_API_KEY=
# ELASTICSEARCH_INDEX=fincon_child_chunks
